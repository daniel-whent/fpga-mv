# Generate dfx/rtl/top.v from the block-design wrapper's port list. The top instantiates the BD wrapper,
# the reconfigurable partition `rp` (din/dout wires to the GPIO) and the strobed 7-segment driver.
# Needs the project open with system_wrapper.v already generated.

set repo [file normalize [file dirname [info script]]/../..]
set wrap [get_files -quiet *system_wrapper.v]
if {$wrap eq ""} { error "system_wrapper.v not found; run the Stage scripts first" }
set fh [open $wrap]; set txt [read $fh]; close $fh

set ports {}
foreach line [split $txt "\n"] {
    if {[regexp {^\s*(input|output|inout)\s*(\[[0-9]+:[0-9]+\])?\s*([A-Za-z_][A-Za-z0-9_]*)\s*;} $line -> dir range name]} {
        lappend ports [list $dir $range $name]
    }
}
set out "// GENERATED by scripts/dfx/gen_top.tcl - do not edit.\nmodule top (\n"
set decl {}
set conn {}
set wires {}
set rpconn {}
foreach p $ports {
    lassign $p dir range name
    lappend conn "        .${name}(${name})"
    if {[string match rp_axi_* $name] || $name eq "rp_aclk" || $name eq "rp_aresetn"} {
        # partition-facing signals stay inside the top: wire to u_rp (BD output -> RP input, and vice versa)
        lappend wires "    wire $range $name;"
        if {$name eq "rp_aclk"} { set rpn s_axi_aclk } elseif {$name eq "rp_aresetn"} { set rpn s_axi_aresetn } else { set rpn s_axi_[string range $name 7 end] }
        lappend rpconn "        .${rpn}(${name})"
        continue
    }
    lappend decl "    $dir $range $name"
}
lappend decl "    output wire \[6:0\] seg" "    output wire seg_dp" "    output wire \[7:0\] an"
append out [join $decl ",\n"] "\n);\n"
append out "[join $wires "
"]
    wire [31:0] rp_value;
"
append out "    system_wrapper u_system (\n[join $conn ",\n"]\n    );\n"
append out "    rp u_rp (
[join $rpconn ",
"],
        .value(rp_value)
    );
"
append out "    seg7_strobe u_seg (.clk(sys_clock), .value(rp_value), .seg_n(seg), .dp_n(seg_dp), .an_n(an));\n"
append out "endmodule\n"
set fo [open $repo/dfx/rtl/top.v w]; puts -nonewline $fo $out; close $fo
puts "Wrote $repo/dfx/rtl/top.v ([llength $ports] wrapper ports)"
